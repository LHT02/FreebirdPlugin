# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Blender autosaves and crash recovery files
*.blend1
*.blend2
*.blend@
*.blend[0-9]
*.blend[0-9][0-9]
blender.crash.txt

# Local Freebird runtime/install data
.freebird/
.local-plugin/
freebird.log

# Local configuration and secrets
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
